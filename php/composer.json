{
    "name": "apiverve/countrylanguages",
    "description": "Country Languages lists official and commonly spoken languages for any country using its two-letter ISO code. It returns the common country name, formal official name, an array of recognized languages, and the total language count.",
    "version": "1.2.2",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "countrylanguages",
        "country languages api",
        "country language lookup",
        "languages spoken by country",
        "official languages by country",
        "list country languages"
    ],
    "homepage": "https://apiverve.com/marketplace/countrylanguages?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/countrylanguages",
        "source": "https://github.com/apiverve/countrylanguages-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Countrylanguages\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "APIVerve\\Countrylanguages\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
